{
  "name": "@swift2/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./fonts/*": "./fonts/*",
    "./reader/lib/*": "./src/reader/lib/*.ts",
    "./reader/store/*": "./src/reader/store/*.tsx",
    "./reader/era/*": "./src/reader/era/*.tsx",
    "./reader/shell/ReaderShell": "./src/reader/shell/ReaderShell.tsx",
    "./reader/shell/TopBar": "./src/reader/shell/TopBar.tsx",
    "./reader/shell/TimelineScrubber": "./src/reader/shell/TimelineScrubber.tsx",
    "./reader/shell/BottomNav": "./src/reader/shell/BottomNav.tsx",
    "./reader/shell/button": "./src/reader/shell/button.tsx",
    "./reader/shell/timelineScrubberLayout": "./src/reader/shell/timelineScrubberLayout.ts",
    "./reader/shell/topbarLayout": "./src/reader/shell/topbarLayout.ts"
  },
  "dependencies": {
    "@swift2/content": "*",
    "@swift2/content-enrichment": "*",
    "@swift2/experience": "*",
    "@swift2/shared": "*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "react": "^18 || ^19"
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  }
}
