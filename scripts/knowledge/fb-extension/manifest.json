{
  "manifest_version": 3,
  "name": "Long Live FB export",
  "version": "2.0.0",
  "description": "Read-only Long Live export of Facebook group leads and the owner's own activity counts; acts only when the local runner hands this tab a job.",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["alarms", "storage", "tabs"],
  "host_permissions": ["http://127.0.0.1/*"],
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*"],
      "js": ["harvest-core.js", "comments.js", "skeleton.js", "content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1/start*"],
      "js": ["harvest-core.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
