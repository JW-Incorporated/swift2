{
  "expo": {
    "name": "LongLive",
    "slug": "swift2-vault",
    "version": "1.0.0",
    "orientation": "default",
    "scheme": "longlive",
    "platforms": ["ios", "android"],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0b0f",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": ["**/*"],
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/a4ff0e9b-ad3e-48a4-a765-ffc19a8b3209"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": false,
      "associatedDomains": ["applinks:longlivets.com", "applinks:www.longlivets.com"],
      "bundleIdentifier": "ai.jwlabs.longlive",
      "buildNumber": "1",
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "ai.jwlabs.longlive",
      "softwareKeyboardLayoutMode": "resize",
      "intentFilters": [
        {
          "autoVerify": true,
          "action": "VIEW",
          "data": [
            { "scheme": "https", "host": "longlivets.com" },
            { "scheme": "https", "host": "www.longlivets.com" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#5B2DC2"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0b0b0f"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "compileSdkVersion": 36,
            "targetSdkVersion": 36,
            "minSdkVersion": 24
          }
        }
      ],
      "expo-notifications",
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "a4ff0e9b-ad3e-48a4-a765-ffc19a8b3209"
      }
    },
    "owner": "jw-labs"
  }
}
