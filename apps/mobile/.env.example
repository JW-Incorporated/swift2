# Content bundle base URL for the Vault reader (OS-015).
# Defaults to the production published bundle (https://www.longlivets.com/content)
# when unset — this override exists only for local dev against a non-production
# deploy (mirrors apps/web/lib/vault.ts's VAULT_FALLBACK_BASE_URL escape hatch).
#
# Local dev:   cp .env.example .env  and set this only if you need to point at
#              a preview/staging deploy instead of production.
# EAS builds:  set as an EAS environment variable if a non-default value is
#              needed for that build profile:
#              eas env:create --scope project --environment preview \
#                --name EXPO_PUBLIC_CONTENT_BASE_URL --value https://<preview-host>/content
#              (see docs/mobile-shipping-checklist.md)
EXPO_PUBLIC_CONTENT_BASE_URL=
