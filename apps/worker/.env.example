# News/Current worker (V2, #468). Copy to apps/worker/.env (gitignored).
#
# SUPABASE_DB_URL already exists for this project (used by the db:migrate /
# db:seed:* scripts, which write via `pg` directly). This worker instead uses
# the supabase-js client for its many small typed queries, which needs a
# DIFFERENT credential shape — the two new values below, both from the SAME
# Supabase project's dashboard (Settings -> API), not a new account/project:
SUPABASE_URL=                    # "Project URL" — same value as NEXT_PUBLIC_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=       # "service_role" secret key — bypasses RLS, keep this OUT of any *_PUBLIC_* var

# Model vendor is OpenAI (docs/decisions.md, 2026-07-18) — leave unset to run
# fully on the deterministic rule-based classifier (the pipeline is designed
# to work with zero LLM calls; this is the normal state until a founder adds
# a real key).
OPENAI_API_KEY=

# Extract stage only (src/extract/) — Anthropic (docs/decisions.md,
# 2026-08-23 "Knowledge engine kickoff"). Leave unset to skip the extract
# stage entirely; clusters stay unextracted and are retried next cycle.
ANTHROPIC_API_KEY=

# Fan/free-tier adapters (PLAN.md Stage 6, docs/decisions.md 2026-08-23).
# Each is designed to no-op (empty result, not a crash) when its own key is
# unset — leave any of these blank to run without that source.
GNEWS_API_KEY=              # gnews.io free tier, 100 req/day hard vendor cap — see sources/gnews.ts
TUMBLR_CONSUMER_API_KEY=    # public-read-only endpoints (sources/tumblr.ts); TUMBLR_SECRET_API_KEY is unused (OAuth, out of scope)
TUMBLR_SECRET_API_KEY=
REDDIT_RSS_ENABLED=         # set to "false" to disable sources/reddit-rss.ts in one place; unset/anything else = enabled
