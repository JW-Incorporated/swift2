{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd ../.. && npm ci --prefer-offline --no-audit --no-fund",
  "ignoreCommand": "node ../../scripts/vercel-ignore-build.mjs",
  "github": {
    "silent": true
  },
  "crons": [
    {
      "path": "/api/notifications/dispatch",
      "schedule": "*/15 * * * *"
    }
  ]
}
