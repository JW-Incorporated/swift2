# Dependencies
node_modules/

# Environment & secrets — never commit
.env
.env.*
# ...except the value-free templates that document required vars
!.env.example
*.pem
*.key
secrets/

# Build output
dist/
build/
.next/
.expo/
.vercel/
*.tsbuildinfo

# Logs & OS noise
*.log
.DS_Store
Thumbs.db

# Local editor/tool state
.claude/settings.local.json
.vscode/
.idea/

# Playwright E2E artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
nul

# News candidate digest — generated every cycle and published to the
# news-digest branch, never tracked on main (see .github/workflows/news-worker.yml).
docs/content-ops/news-candidates.md

# Backup/restore drill artifacts (scripts/backup-restore-test.mjs) — dumps of
# real data plus throwaway Postgres clusters. Never tracked.
/.backups/

# Keyed live-battery transcripts (npm run clownbot:battery -- --out=...). Run
# artifacts: large, full of raw model output, and regenerated every run. The
# runbook (docs/ops/clownbot-launch-gate.md) says attach them to the launch
# thread, never commit them — this makes that the default rather than a rule
# someone has to remember at 2am.
clownbot-battery-*.json

# Thread hero crop previews (scripts/images/thread-hero.mjs preview) — throwaway
# renders used to choose a `heroPosition` by looking at it. The hero itself is
# committed to apps/web/public/threads/; these are the working shots.
/thread-hero-preview/

# Agent scratch output (CLAUDE.md § Mechanics) — filtered command output and
# throwaway working files. Never tracked.
.scratch/

# Repowise local index (repowise-setup skill) — rebuildable, never tracked.
.repowise/
codex-full-log.jsonl
codex-stdout.log

# Stale PLAN.md snapshots renamed off the live filename (machine-retirement
# audit, 2026-08-27) — superseded plan backups, never tracked.
PLAN.md.bak-*

# Local portable Python runtime install (machine-retirement audit,
# 2026-08-27) — not project source, never tracked.
/Python/

# Scratch product-link export, deliberately left local since 2026-08-19
# (docs/handoff/2026-08-19-paused-work.md) — never tracked.
.scratch-products.json

# Stale pre-#2040 draft of the tracked test file, left local since
# 2026-08-19 (docs/handoff/2026-08-19-paused-work.md) — never tracked.
scripts/social/social-poster-workflow.test.ts.tmp

# Owner decision 2026-08-27 (machine-retirement audit): these three stay
# local-only — routine export carries account-bound connector UUIDs;
# orphaned draft; personal screenshot. Never tracked.
/swift2-routine-export-*.md
/evermore_block.txt
social/joey/Screenshot*.png

# iOS App Store Connect API key (real credential, never commit)
apps/mobile/credentials/
apps/mobile/credentials.json

# Published content bundle (OS-012) — build output written by
# scripts/publish-content-bundle.mjs during apps/web's `prebuild`. Every
# merge regenerates it deterministically from supabase/seed/**; never
# tracked (docs/specs/2026-09-05-one-source-three-surfaces.md §6).
/apps/web/public/content/

# Long Live generated content vault (OS-014, docs/specs/2026-09-05-one-source-
# three-surfaces.md): these are pure, deterministic output of `npm run
# sync:content` / `prebuild` from supabase/seed/** (scripts/sync-longlive-
# *.mjs, scripts/sync-song-moods.mjs, scripts/sync-clownbot-lore.mjs) — 3.6MB
# of derived TypeScript that added no reviewable signal to diffs and is
# regenerated identically on every clone/CI run. Never hand-edited; never
# committed. See scripts/lib/generated-content.mjs (the manifest of what
# generates what) and docs/longlive-experience.md §9.
apps/web/lib/longlive/*.generated.ts
