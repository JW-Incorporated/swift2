{
  "name": "swift2",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "npm run dev --workspace @swift2/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "build": "npm run build --workspaces --if-present",
    "db:migrate": "node --env-file=apps/worker/.env scripts/migrate.mjs",
    "db:seed": "node --env-file=apps/worker/.env scripts/seed-eras.mjs",
    "db:seed:content": "node --env-file=apps/worker/.env scripts/seed-content.mjs",
    "db:seed:tracks": "node --env-file=apps/worker/.env scripts/seed-tracks.mjs",
    "db:seed:releases": "node --env-file=apps/worker/.env scripts/seed-releases.mjs",
    "db:seed:tours": "node --env-file=apps/worker/.env scripts/seed-tours.mjs",
    "db:seed:theories": "node --env-file=apps/worker/.env scripts/seed-theories.mjs",
    "db:seed:videos": "node --env-file=apps/worker/.env scripts/seed-videos.mjs",
    "check:budget": "tsx scripts/check-tier0-budget.mjs",
    "check:budget:seed": "tsx scripts/check-budget-from-seed.mjs",
    "sync:content": "node scripts/sync-longlive-content.mjs && node scripts/sync-longlive-tracks.mjs && node scripts/sync-longlive-theories.mjs && node scripts/sync-longlive-videos.mjs && node scripts/sync-longlive-era-secrets.mjs && node scripts/sync-song-moods.mjs",
    "check:generated": "node scripts/check-generated-in-sync.mjs",
    "check:automerge-allowlist": "node scripts/check-automerge-allowlist.mjs",
    "check:launch-gates": "node scripts/check-launch-gates.mjs",
    "check:content-ownership": "node scripts/check-content-ownership.mjs",
    "check:work-ownership": "node scripts/check-work-ownership.mjs",
    "check:no-downgrade": "node scripts/check-no-downgrade.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:social": "node scripts/social/validate-queue.mjs",
    "check:content-inert": "node scripts/check-content-inert.mjs",
    "content:coverage": "node scripts/content-coverage.mjs",
    "karen": "node scripts/content-engine/run.mjs all",
    "karen:file": "node scripts/content-engine/run.mjs all --create",
    "cie": "node scripts/content-engine/run.mjs all",
    "cie:file": "node scripts/content-engine/run.mjs all --create",
    "social:card": "tsx scripts/social/render-card.mjs",
    "social:capture": "node scripts/social/capture-screens.mjs",
    "social:seed-library": "tsx scripts/social/seed-library.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/playfair-display": "^5.3.0",
    "@playwright/test": "^1.62.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "eslint": "^10.8.1",
    "pg": "^8.12.0",
    "prettier": "^3.9.6",
    "satori": "^0.29.0",
    "sharp": "^0.35.3",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
